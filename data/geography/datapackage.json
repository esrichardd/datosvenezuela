{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "venezuela-geography",
  "title": "Geografía de Venezuela",
  "description": "Estados, municipios y parroquias de Venezuela con los códigos P-code de OCHA. Cada nivel apunta a su nivel superior. Fuentes, criterios y correcciones en SOURCES.md.",
  "homepage": "https://github.com/esrichardd/datosvenezuela",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "title": "Creative Commons Attribution 4.0 International",
      "path": "https://creativecommons.org/licenses/by/4.0/"
    }
  ],
  "sources": [
    {
      "title": "Venezuela (Bolivarian Republic of) – Subnational Administrative Boundaries (COD-AB), OCHA en HDX, con datos del INE. Licencia CC BY-IGO.",
      "path": "https://data.humdata.org/dataset/5b141d29-534f-4f01-a0bc-41e2f375d925"
    }
  ],
  "resources": [
    {
      "name": "states",
      "type": "table",
      "path": "states.csv",
      "title": "Estados",
      "description": "Las entidades federales: los estados, el Distrito Capital y las Dependencias Federales.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "code",
            "type": "string",
            "description": "P-code de OCHA de la entidad.",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "^VE[0-9]{2}$"
            }
          },
          {
            "name": "name",
            "type": "string",
            "description": "Nombre oficial.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "type",
            "type": "string",
            "description": "Tipo de entidad.",
            "constraints": {
              "required": true,
              "enum": [
                "state",
                "capital_district",
                "federal_dependencies"
              ]
            }
          },
          {
            "name": "iso_3166_2",
            "type": "string",
            "description": "Código ISO 3166-2:VE.",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "^VE-[A-Z]$"
            }
          },
          {
            "name": "capital",
            "type": "string",
            "description": "Ciudad capital. Vacío para las Dependencias Federales."
          }
        ],
        "primaryKey": [
          "code"
        ]
      }
    },
    {
      "name": "municipalities",
      "type": "table",
      "path": "municipalities.csv",
      "title": "Municipios",
      "description": "Los municipios de cada estado.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "code",
            "type": "string",
            "description": "P-code de OCHA del municipio; empieza con el código de su estado.",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "^VE[0-9]{4}$"
            }
          },
          {
            "name": "state_code",
            "type": "string",
            "description": "P-code del estado al que pertenece.",
            "constraints": {
              "required": true,
              "pattern": "^VE[0-9]{2}$"
            }
          },
          {
            "name": "name",
            "type": "string",
            "description": "Nombre oficial.",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": [
          "code"
        ],
        "foreignKeys": [
          {
            "fields": [
              "state_code"
            ],
            "reference": {
              "resource": "states",
              "fields": [
                "code"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "parishes",
      "type": "table",
      "path": "parishes.csv",
      "title": "Parroquias",
      "description": "Las parroquias de cada municipio.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "code",
            "type": "string",
            "description": "P-code de OCHA de la parroquia; empieza con el código de su municipio.",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "^VE[0-9]{6}$"
            }
          },
          {
            "name": "municipality_code",
            "type": "string",
            "description": "P-code del municipio al que pertenece.",
            "constraints": {
              "required": true,
              "pattern": "^VE[0-9]{4}$"
            }
          },
          {
            "name": "name",
            "type": "string",
            "description": "Nombre oficial.",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": [
          "code"
        ],
        "foreignKeys": [
          {
            "fields": [
              "municipality_code"
            ],
            "reference": {
              "resource": "municipalities",
              "fields": [
                "code"
              ]
            }
          }
        ]
      }
    }
  ]
}
