# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs.
[*.go]
indent_style = tab
indent_size = 4

# make requires tabs.
[Makefile]
indent_style = tab

# Two trailing spaces mean a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
