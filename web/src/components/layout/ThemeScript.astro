---
/**
 * Sets the theme before the page is painted, so it never flashes the wrong
 * one. It must be inline and blocking, so it cannot import src/lib/theme.ts:
 * the storage key "theme" must match THEME_STORAGE_KEY there.
 */
---

<script is:inline>
  (() => {
    let theme = null;
    try {
      theme = localStorage.getItem("theme");
    } catch {
      // Storage unavailable: fall back to the system theme.
    }
    if (theme !== "light" && theme !== "dark") {
      theme = matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
