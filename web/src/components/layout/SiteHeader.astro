---
/** Site header: logo, main navigation, theme toggle and mobile menu. */
import { site } from "../../config/site";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import IconButton from "../ui/IconButton.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header" data-site-header>
  <Container class="site-header__inner">
    <Logo />
    <div class="site-header__actions">
      <nav id="site-nav" class="site-header__nav" aria-label="Principal">
        <ul>
          {site.nav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={
                  !link.external && isCurrent(link.href) ? "page" : undefined
                }
                rel={link.external ? "noopener" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
      <IconButton
        class="site-header__menu"
        data-menu-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="site-header__menu-open" />
        <Icon name="close" class="site-header__menu-close" />
      </IconButton>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: relative;
    background-color: var(--color-bg-emphasis);
    color: var(--color-fg-on-emphasis);
  }

  .site-header :global(.site-header__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    color: inherit;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-primary);
  }

  .site-header__nav a[aria-current="page"] {
    box-shadow: inset 0 calc(-1 * var(--border-width)) 0 var(--color-primary);
  }

  .site-header :global(.site-header__menu),
  .site-header :global(.site-header__menu-close) {
    display: none;
  }

  /* Phone: the navigation collapses behind the menu button. */
  @media (width < 560px) {
    .site-header__actions {
      gap: var(--space-2);
    }

    .site-header :global(.site-header__menu) {
      display: inline-flex;
    }

    .site-header__nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      z-index: 10;
      background-color: var(--color-bg-emphasis);
      border-top: var(--border-width) solid var(--color-border-on-emphasis);
    }

    .site-header__nav ul {
      flex-direction: column;
      gap: 0;
    }

    .site-header__nav a {
      width: 100%;
      padding-inline: var(--container-padding);
      border-bottom: var(--border-width) solid var(--color-border-on-emphasis);
    }

    .site-header[data-menu-open] .site-header__nav {
      display: block;
    }

    .site-header[data-menu-open] :global(.site-header__menu-open) {
      display: none;
    }

    .site-header[data-menu-open] :global(.site-header__menu-close) {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const button = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");

  function setOpen(open: boolean): void {
    if (!header || !button) return;
    header.toggleAttribute("data-menu-open", open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  }

  button?.addEventListener("click", () =>
    setOpen(!header?.hasAttribute("data-menu-open")),
  );

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.hasAttribute("data-menu-open")) {
      setOpen(false);
      button?.focus();
    }
  });

  header
    ?.querySelectorAll("#site-nav a")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>
