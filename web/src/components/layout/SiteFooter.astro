---
/** Site footer: author credit, license and secondary navigation. */
import { site } from "../../config/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<footer class="site-footer">
  <Container class="site-footer__inner">
    <p class="site-footer__credit">
      Hecho por <strong>{site.author.name}</strong>
      <span class="site-footer__links">
        {site.author.links.map((link) => (
          <Button href={link.href} variant="outline" size="sm" rel="me">
            {link.label}
          </Button>
        ))}
      </span>
    </p>
    <p class="site-footer__license">{site.license}</p>
    <nav aria-label="Pie de página">
      <ul class="site-footer__nav">
        {site.nav.map((link) => (
          <li>
            <a href={link.href} rel={link.external ? "noopener" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .site-footer :global(.site-footer__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6) var(--space-10);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .site-footer__credit strong {
    color: var(--color-fg);
    font-weight: var(--font-weight-semibold);
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-2);
    color: var(--color-fg);
  }

  .site-footer__nav {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--color-fg);
  }
</style>
