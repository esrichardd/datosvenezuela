---
/**
 * A row of buttons or links. On phones the buttons stack and take the
 * full width, which makes them easier to tap.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class:list={["button-row", className]} {...rest}>
  <slot />
</div>

<style>
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (width < 560px) {
    .button-row > :global(*) {
      flex: 1 1 100%;
    }
  }
</style>
