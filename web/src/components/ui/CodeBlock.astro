---
/**
 * A dark frame for code, with an optional title bar (a file name, a
 * language...). The content goes in the default slot: a <pre> for plain
 * code, or rendered lines (see Diff.astro).
 *
 * - title: plain text for the title bar. For richer content, fill the
 *   "title" slot instead.
 * - fill: the frame takes the height of its parent and the body scrolls.
 */
interface Props {
  title?: string;
  fill?: boolean;
  class?: string;
}

const { title, fill = false, class: className } = Astro.props;
const hasTitleSlot = Astro.slots.has("title");
---

<figure class:list={["code-block", { "code-block--fill": fill }, className]}>
  {(title || hasTitleSlot) && (
    <figcaption class="code-block__title">
      <slot name="title">{title}</slot>
    </figcaption>
  )}
  <div class="code-block__body">
    <slot />
  </div>
</figure>

<style>
  .code-block {
    margin: 0;
    min-width: 0;
    border: var(--border-width) solid var(--color-code-border);
    background-color: var(--color-code-bg);
    color: var(--color-code-fg);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .code-block--fill {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .code-block__title {
    position: relative;
    padding: var(--space-3) var(--space-5);
    border-bottom: var(--border-width) solid var(--color-code-border);
    color: var(--color-code-fg-muted);
    font-size: var(--font-size-xs);
  }

  .code-block__body {
    --code-block-padding: var(--space-5);

    padding: var(--code-block-padding);
  }

  .code-block--fill .code-block__body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    scrollbar-color: var(--color-accent) transparent;
    scrollbar-width: thin;
  }

  .code-block__body :global(pre) {
    margin: 0;
    font: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (width < 560px) {
    .code-block {
      font-size: var(--font-size-xs);
    }

    .code-block__body {
      --code-block-padding: var(--space-4);
    }
  }
</style>
