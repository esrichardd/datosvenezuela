---
/**
 * Home hero: what the project is and the two main actions.
 * An optional "aside" slot holds the map on wide screens.
 */
import { routes } from "../../config/site";
import EmphasisSurface from "../layout/EmphasisSurface.astro";
import Button from "../ui/Button.astro";
import ButtonRow from "../ui/ButtonRow.astro";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Lead from "../ui/Lead.astro";

const hasAside = Astro.slots.has("aside");
---

<EmphasisSurface as="section" aria-labelledby="hero-title">
  <Container>
    <div class:list={["hero", { "hero--with-aside": hasAside }]}>
      <div class="hero__content">
        <Heading level={1} size="display" id="hero-title">
          Venezuela, código por código.
        </Heading>
        <Lead>
          Estados, municipios, parroquias, bancos, prefijos y feriados. Datos
          oficiales en una API gratuita, sin registro ni API key.
        </Lead>
        <ButtonRow>
          <Button href={routes.docs}>Ver documentación</Button>
          <Button href="#api" variant="outline">
            Probar la API ↓
          </Button>
        </ButtonRow>
      </div>
      {hasAside && (
        <div class="hero__aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  </Container>
</EmphasisSurface>

<style>
  .hero {
    display: grid;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-12) var(--space-20);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* The aside (map) only shows on desktop, next to the text. */
  .hero__aside {
    display: none;
  }

  @media (width >= 1100px) {
    .hero--with-aside {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }

    .hero__aside {
      display: block;
    }
  }

  @media (width < 560px) {
    .hero {
      padding-block: var(--space-6) var(--space-12);
    }

    .hero__content {
      gap: var(--space-6);
    }
  }
</style>
